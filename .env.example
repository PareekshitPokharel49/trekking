# Local dev: copy to .env.local. These are NEXT_PUBLIC_* — they are inlined
# into the client bundle at build time (EmailJS keys are meant to be public).
# In CI they are passed as Docker build args from GitHub Secrets.

# EmailJS — https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# --- Deploy: used by docker-compose on the VPS only ---
# Domain Caddy should request a certificate for.
SITE_ADDRESS=callfromhimalaya.org
# Image tag to run (CI sets this to the git SHA; defaults to :latest).
IMAGE=ghcr.io/pareekshitpokharel49/trekking:latest
