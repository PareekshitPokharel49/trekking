# EmailJS keys are also baked into app/lib/submitForm.ts as defaults, so
# the site works without any of this. Set these only to override them.
# They are NEXT_PUBLIC_* (public by design — lock sending to your domain
# in EmailJS -> Account -> Security -> Allowed Origins).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_7dr2na9
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_uylg8qj
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=7Vv80XxRYBhBi7jsT

# --- Deploy: used by docker-compose on the VPS only ---
# Domain Caddy should request a certificate for.
SITE_ADDRESS=callfromhimalaya.org
# Image tag to run (CI sets this to the git SHA; defaults to :latest).
IMAGE=ghcr.io/pareekshitpokharel49/trekking:latest
